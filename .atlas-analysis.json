  "keyFeatures": [
    "Drop-in authkitLoader for Remix route loaders with automatic token refresh",
    "Callback route handler (authLoader) for OAuth code exchange",
    "PKCE-based browser-bound sign-in flow with cookie-based verifier storage",
    "Encrypted session storage using iron-session with customizable backends",
    "getSignInUrl / getSignUpUrl returning URL + cookie headers to forward",
    "signOut with optional returnTo redirect, clearing session and PKCE cookies",
    "switchToOrganization for multi-tenant org switching with automatic re-auth",
    "withAuth for low-level access token access without automatic refresh",
    "Flexible configuration via environment variables or programmatic configure()",
    "Support for custom SessionStorage implementations (memory, Redis, database)"
  ],
  "publicApiSurface": [
    "authkitLoader(loaderArgs, loaderOrOptions?, options?)",
    "authLoader(options?)",
    "withAuth(args)",
    "getSignInUrl(returnPathname?, request?)",
    "getSignUpUrl(returnPathname?, request?)",
    "signOut(request, options?)",
    "switchToOrganization(request, organizationId, options?)",
    "configure(configOrSource, source?)",
    "getConfig(key)",
    "getWorkOS()",
    "GetAuthURLResult (type)",
    "AuthKitLoaderOptions (type)",
    "HandleAuthOptions (type)",
    "AuthorizedData (type)",
    "UnauthorizedData (type)",
    "Impersonator (type)",
    "AuthKitConfig (type)"
  ]
